# Copia este archivo como .env y pega tus claves. Nunca subas .env al repositorio.
# Guía para obtener cada clave: docs/claves.md

# Hacker News (Algolia), arXiv y RSS no necesitan clave.

# YouTube Data API v3
YOUTUBE_API_KEY=

# Eden AI (clasificador JEV). Opcional: sin clave o sin saldo se usa el respaldo con el modelo rápido.
EDENAI_API_KEY=
EDENAI_MODEL=typesafe/jev-latest

# Proveedor de redacción: gemini (sin costo) o anthropic (modo calidad)
LLM_PROVIDER=gemini

# Gemini: nivel gratuito o créditos de Google Cloud
# aistudio: nivel gratuito de AI Studio. vertex: Agent Platform, usa los créditos de Google Cloud.
GEMINI_BACKEND=aistudio
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_WRITER=gemini-flash-latest
# Precio opcional en dólares por millón de tokens "entrada,salida". Vacío = nivel gratuito (costo 0).
# Con GEMINI_BACKEND=vertex se recomienda gemini-2.5-flash-lite (0.10,0.40) y gemini-2.5-pro (1.25,10).
GEMINI_PRICE_FAST=
GEMINI_PRICE_WRITER=
# Brief en vivo desde la página: un modelo rápido (responde en unos 5 segundos).
GEMINI_MODEL_LIVE=gemini-2.5-flash
GEMINI_PRICE_LIVE=0.30,2.50

# Anthropic: recomendado para explicaciones y briefs más precisos
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_WRITER=claude-opus-5-5

# Sensor humano: hoja de respuestas del formulario publicada como CSV. Es secreta. Ver docs/sensor-humano.md
SENSOR_SHEET_CSV_URL=

# Tope de costo por corrida en dólares
RUN_COST_LIMIT_USD=1.50
